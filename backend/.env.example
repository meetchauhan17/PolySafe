# Database Connection URL (PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/polysafe?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-polysafe-2026"

# AI & LLM Service Credentials (Groq / Gemini)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# OCR Service Credentials
OCR_SPACE_API_KEY="your_ocr_space_api_key_here"

# Firebase Credentials
FIREBASE_PROJECT_ID="polysafe-app"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@polysafe-app.iam.gserviceaccount.com"

# Server Configuration
PORT=5000
NODE_ENV="development"

# OTP Mode: set to "true" to use Firebase Phone Auth, "false" for stub (console) mode
USE_FIREBASE_OTP="false"

# JWT config
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE
# Set to "true" before a live demonstration on an unreliable venue network.
# When true, ALL external API calls are intercepted and return pre-written
# fixture data. No live network requests are made to OCR.space, RxNorm, or Groq.
#
# Every mock is explicitly labelled in src/lib/demo.js — nothing is hidden.
# Flip back to "false" (or remove the variable) before returning to production.
#
# Affected endpoints when DEMO_MODE=true:
#   POST /medicine/scan  → returns a Warfarin prescription sample (OCR.space not called)
#   POST /medicine       → returns a mock RxCUI from a static map (RxNav not called)
#   (background async)  → returns pre-written clinical/plain explanations (Groq not called)
# ─────────────────────────────────────────────────────────────────────────────
DEMO_MODE="false"
